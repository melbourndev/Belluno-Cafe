---
/**
 * shadcn-style Button for Astro — variant-driven pill buttons with the
 * site-wide bottom-up fill. Usage: <Button href="/menu">Explore</Button>
 */
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../../lib/cn';

const buttonVariants = cva(
  'btn-fill inline-flex items-center justify-center gap-2 rounded-full text-sm font-semibold transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] active:scale-[0.98]',
  {
    variants: {
      variant: {
        default: 'btn-fill-dark bg-ink text-cream',
        cream: 'btn-fill-dark bg-cream text-ink',
        outline: 'border border-black/20',
        creamOutline: 'border border-cream/40 text-cream',
        ghost: 'hover:bg-black/5',
      },
      size: {
        default: 'px-7 py-3.5 min-h-[44px]',
        sm: 'px-5 py-2.5',
        icon: 'w-11 h-11',
      },
    },
    defaultVariants: { variant: 'default', size: 'default' },
  },
);

export type ButtonProps = VariantProps<typeof buttonVariants> & {
  href?: string;
  class?: string;
  ariaLabel?: string;
};

const { variant, size, href, class: cls, ariaLabel } = Astro.props as ButtonProps;
const Tag = href ? 'a' : ('button' as const);
---

<Tag href={href} aria-label={ariaLabel} class={cn(buttonVariants({ variant, size }), cls)}>
  <slot />
</Tag>
