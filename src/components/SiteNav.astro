---
/**
 * Global glassmorphism pill nav (desktop) + fullscreen overlay (mobile).
 * One instance per page. Pass `active` to highlight the current section.
 */
import { cn } from '../lib/cn';
import { X } from '@keyline-icons/react/duotone';

type Props = { active?: 'home' | 'menu' | 'about' | 'contact' };
const { active } = Astro.props as Props;

const links = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/menu', label: 'Menu', key: 'menu' },
  { href: '/about', label: 'About', key: 'about' },
  { href: '/contact', label: 'Contact', key: 'contact' },
] as const;
---

<header id="siteHeader" class="fixed top-4 inset-x-0 z-50 px-4 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
  <nav
    id="sitePill"
    aria-label="Primary"
    class="max-w-6xl mx-auto bg-cream/70 backdrop-blur-xl backdrop-saturate-150 border border-white/50 rounded-full px-4 sm:px-6 py-2.5 flex items-center justify-between transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
    style="box-shadow:inset 0 1px 0 rgba(255,255,255,0.55),0 20px 40px -24px rgba(28,26,22,0.28)"
  >
    <a href="/" class="flex items-center gap-2" aria-label="Belluno home">
      <img src="/assets/full-logo.avif" alt="Belluno" class="h-11 sm:h-12 w-auto object-contain" />
    </a>
    <div class="hidden md:flex items-center gap-7 text-sm font-medium">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={active === l.key ? 'page' : undefined}
            class={cn('px-1 py-1 transition-opacity', active === l.key ? 'font-bold opacity-100' : 'opacity-60 hover:opacity-100')}
          >
            {l.label}
          </a>
        ))
      }
    </div>
    <div class="flex items-center gap-2">
      <a href="/contact" class="btn-fill btn-fill-dark hidden sm:inline-block bg-ink text-cream text-sm font-semibold px-5 py-2.5 rounded-full">Visit Us</a>
      <button id="navToggle" class="md:hidden w-10 h-10 grid place-items-center rounded-full border relative" aria-label="Open menu" aria-expanded="false">
        <span class="nav-line block w-5 h-[1.5px] bg-current absolute transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] -translate-y-[4px]"></span>
        <span class="nav-line block w-5 h-[1.5px] bg-current absolute transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] translate-y-[4px]"></span>
      </button>
    </div>
  </nav>
  <div id="mobileMenu" class="hidden md:hidden fixed inset-0 z-40 bg-cream/90 backdrop-blur-3xl" role="dialog" aria-label="Site menu">
    <button id="menuClose" class="absolute top-5 right-5 w-11 h-11 grid place-items-center rounded-full bg-ink text-cream hover:bg-pine active:scale-[0.98] transition" aria-label="Close menu"><X className="size-5" /></button>
    <div class="h-full flex flex-col justify-center px-10 gap-1 text-4xl font-serif">
      <a href="/" class="mm-link opacity-0 translate-y-12 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] py-2">Home</a>
      <a href="/menu" class="mm-link opacity-0 translate-y-12 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] py-2 delay-100">Menu</a>
      <a href="/about" class="mm-link opacity-0 translate-y-12 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] py-2 delay-150">About</a>
      <a href="/contact" class="mm-link opacity-0 translate-y-12 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] py-2 delay-200">Contact</a>
      <a href="/contact" class="mm-link opacity-0 translate-y-12 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] py-2 delay-200 mt-4 text-base font-sans font-semibold bg-ink text-cream px-6 py-3 rounded-full w-max">Visit Us</a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('siteHeader');
  const pill = document.getElementById('sitePill');
  const toggle = document.getElementById('navToggle');
  const menu = document.getElementById('mobileMenu');
  let open = false;
  let lastY = window.scrollY;

  function setNav(state: boolean) {
    open = state;
    toggle?.setAttribute('aria-expanded', String(state));
    toggle?.setAttribute('aria-label', state ? 'Close menu' : 'Open menu');
    const lines = toggle?.querySelectorAll('.nav-line');
    if (lines?.length) {
      (lines[0] as HTMLElement).style.transform = state ? 'translateY(0) rotate(45deg)' : '';
      (lines[1] as HTMLElement).style.transform = state ? 'translateY(0) rotate(-45deg)' : '';
      lines[0].classList.toggle('-translate-y-[4px]', !state);
      lines[1].classList.toggle('translate-y-[4px]', !state);
    }
    menu?.classList.toggle('hidden', !state);
    document.body.style.overflow = state ? 'hidden' : '';
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        menu?.querySelectorAll('.mm-link').forEach((a) => {
          a.classList.toggle('opacity-0', !state);
          a.classList.toggle('translate-y-12', !state);
        });
      }),
    );
  }

  toggle?.addEventListener('click', () => setNav(!open));
  document.getElementById('menuClose')?.addEventListener('click', () => setNav(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setNav(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) setNav(false);
  });

  let ticking = false;
  function onScroll() {
    ticking = false;
    const y = window.scrollY;
    if (pill) {
      if (y > 24) {
        pill.style.paddingTop = '.5rem';
        pill.style.paddingBottom = '.5rem';
      } else {
        pill.style.paddingTop = '';
        pill.style.paddingBottom = '';
      }
    }
    if (header && !open) {
      if (y > 480 && y > lastY + 4) header.style.transform = 'translateY(-140%)';
      else if (y < lastY - 4 || y < 480) header.style.transform = '';
    }
    lastY = y;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(onScroll);
      }
    },
    { passive: true },
  );
</script>
