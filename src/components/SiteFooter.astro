---
/** Global premium footer — deep sea green, giant wordmark, artwork base. */
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';
import { ArrowUpRight, ArrowUp, Check, X, Star } from '@keyline-icons/react/duotone';
---

<footer class="text-cream" style="background:#2F5C4F">
  <div class="max-w-6xl mx-auto px-4 pt-16 sm:pt-20 pb-12">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8">
      <div>
        <Badge dark>Vesu · Surat · Open till midnight</Badge>
        <p class="font-serif font-medium tracking-[-0.02em] leading-none text-6xl sm:text-8xl mt-4">Belluno</p>
        <p class="text-cream/70 text-sm mt-3 max-w-[42ch]">A boutique villa cafe for slow coffee dates and rooftop evenings.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href="tel:09274073791" variant="cream">Call 092740 73791</Button>
        <Button href="/contact" variant="creamOutline">Get directions <ArrowUpRight className="size-4" /></Button>
      </div>
    </div>
    <div class="border-t border-cream/15 mt-12 pt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-10 text-sm">
      <div>
        <div class="flex items-center">
          <img src="/assets/full-logo.png" class="h-12 sm:h-14 w-auto object-contain" alt="Belluno" />
        </div>
        <p class="text-cream/65 mt-4 leading-relaxed">Boutique villa cafe · Vesu, Surat<br />Open every day · Closes 12:00 AM</p>
        <p class="mt-4 inline-flex items-center gap-2 text-xs font-semibold text-cream bg-cream/10 border border-cream/15 px-3.5 py-2 rounded-full">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-300"></span>Open now · Dine-in + Takeaway
        </p>
      </div>
      <nav aria-label="Explore">
        <p class="font-semibold text-cream/45 text-xs tracking-[0.2em]">EXPLORE</p>
        <a class="block mt-4 text-cream/85 hover:text-cream hover:pl-1 transition-all" href="/">Home</a>
        <a class="block mt-2.5 text-cream/85 hover:text-cream hover:pl-1 transition-all" href="/menu">Menu</a>
        <a class="block mt-2.5 text-cream/85 hover:text-cream hover:pl-1 transition-all" href="/about">About</a>
        <a class="block mt-2.5 text-cream/85 hover:text-cream hover:pl-1 transition-all" href="/contact">Contact</a>
      </nav>
      <div>
        <p class="font-semibold text-cream/45 text-xs tracking-[0.2em]">GOOD TO KNOW</p>
        <p class="mt-4 text-cream/85 flex items-center gap-2">Dine-in <Check className="size-4" /></p>
        <p class="mt-2.5 text-cream/85 flex items-center gap-2">Takeaway <Check className="size-4" /></p>
        <p class="mt-2.5 text-cream/40 flex items-center gap-2">Delivery <X className="size-4" /> <span class="text-cream/30">— kitchen-fresh only</span></p>
        <p class="mt-2.5 text-cream/85 flex items-center gap-2"><Star className="size-4" /> 4.6 · 891 reviews</p>
      </div>
      <div>
        <p class="font-semibold text-cream/45 text-xs tracking-[0.2em]">FIND US</p>
        <p class="mt-4 text-cream/85 leading-relaxed">VIP Rd, opp. Marina Grand Hospital,<br />Vesu, Surat 395007<br /><span class="text-cream/55">4QP6+66 Surat</span></p>
        <a class="mt-3 inline-block font-semibold underline underline-offset-4 decoration-cream/40 hover:decoration-cream" href="tel:09274073791">092740 73791</a><br />
        <a
          class="mt-1.5 inline-flex items-center gap-1 text-cream/70 underline underline-offset-4 decoration-cream/25 hover:text-cream"
          href="https://www.google.com/maps/search/?api=1&query=Belluno+Vesu+Surat+4QP6%2B66"
          target="_blank"
          rel="noopener">Open in Maps <ArrowUpRight className="size-4" /></a
        >
      </div>
    </div>
  </div>
  <img
    src="/assets/footer-bg.avif"
    alt=""
    aria-hidden="true"
    loading="lazy"
    class="w-full h-56 sm:h-72 object-cover opacity-40"
    style="mask-image:linear-gradient(to bottom,black 20%,rgba(0,0,0,0.1));-webkit-mask-image:linear-gradient(to bottom,black 20%,rgba(0,0,0,0.1))"
  />
  <div class="border-t border-cream/15">
    <div class="max-w-6xl mx-auto px-4 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-cream/50">
      <p>© 2026 Belluno · Crafted in Vesu, Surat</p>
      <p class="flex items-center gap-4">
        <a href="/privacy" class="hover:text-cream transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-cream transition-colors">Terms</a>
        <a href="#main" class="hover:text-cream transition-colors inline-flex items-center gap-1.5">Back to top <ArrowUp className="size-3.5" /></a>
      </p>
    </div>
  </div>
</footer>
