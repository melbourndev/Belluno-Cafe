---
/** Menu — banner categories, dotted-leader rows, floating tray + checkout. */
import SiteLayout from '../layouts/SiteLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Schema from '../components/Schema.astro';
import { MENU, BASECATS } from '../data/site';
import { SITE } from '../lib/site';

const menuSchema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: 'Belluno Menu',
  url: SITE + '/menu',
  hasMenuSection: BASECATS.map((c) => ({
    '@type': 'MenuSection',
    name: c.title,
    hasMenuItem: MENU.filter((m) => m.cat === c.key).map((m) => ({
      '@type': 'MenuItem',
      name: m.name,
      description: m.desc,
      offers: { '@type': 'Offer', price: String(m.price), priceCurrency: 'INR' },
    })),
  })),
};
---

<SiteLayout
  title="Menu — Belluno Rooftop Cafe, Vesu Surat"
  description="The Belluno menu with prices: hot brews, mocktails and kitchen plates. Dine-in and takeaway on VIP Road, Vesu, Surat."
  active="menu"
>
  <Schema data={menuSchema} />
  <main id="main" class="max-w-6xl mx-auto px-4 pt-10 pb-28">
    <Badge>Eat + Drink</Badge>
    <h1 class="font-serif font-medium tracking-[-0.02em] leading-[0.95] text-5xl sm:text-7xl mt-3">The menu.</h1>
    <p class="text-sm text-neutral-500 mt-3 max-w-[52ch]">Hot brews, mocktails, kitchen plates. Dine-in or takeaway, open daily till midnight.</p>

    <div class="mt-7 flex flex-col sm:flex-row gap-2 sm:items-center">
      <div class="flex-1 flex items-center bg-white border border-black/10 rounded-full px-4 py-3 shadow-[0_18px_40px_-28px_rgba(28,26,22,0.4)]">
        <span class="text-neutral-400 mr-2" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="5" /><path d="M11 11l3 3" /></svg></span>
        <input id="q" class="w-full bg-transparent outline-none text-sm" placeholder="Search the menu…" aria-label="Search menu items" />
      </div>
      <div class="flex flex-wrap gap-2 text-xs font-semibold" id="jumpPills"></div>
    </div>
    <p id="count" class="text-xs text-neutral-500 mt-3"></p>

    <div id="board" class="mt-8 space-y-14">
      {
        BASECATS.map((c) => (
          <section id={`cat-${c.key}`} class="scroll-mt-28">
            <div class="relative overflow-hidden rounded-[1.75rem] h-40 sm:h-52">
              <img src={c.img} alt={c.alt} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/15 to-transparent" aria-hidden="true"></div>
              <div class="absolute bottom-4 left-5 right-5 flex items-end justify-between gap-3">
                <h2 class="font-serif italic font-medium text-cream text-3xl sm:text-4xl">{c.title}</h2>
                <p class="text-xs text-cream/75 hidden sm:block">{c.blurb}</p>
              </div>
            </div>
            <div class="mt-4 grid md:grid-cols-2 gap-3">
              {
                MENU.filter((m) => m.cat === c.key).map((m) => (
                  <div class="bg-white border border-black/5 rounded-2xl px-4 sm:px-5 py-3.5">
                    <div class="flex items-center gap-2">
                      <p class="font-semibold text-[0.95rem] leading-tight">
                        {m.name} <span class="text-[11px] font-medium text-neutral-400">★ {m.rating}</span>
                      </p>
                      <span class="leader" aria-hidden="true"></span>
                      <b class="text-[0.95rem] shrink-0">₹{m.price}</b>
                    </div>
                    <p class="text-xs text-neutral-500 mt-1">{m.desc}</p>
                  </div>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>

    <div class="mt-14 bg-pine text-cream rounded-[2rem] p-8 sm:p-10 flex flex-col sm:flex-row sm:items-center justify-between gap-5 reveal">
      <div>
        <h2 class="font-serif font-medium text-3xl">Hungry already?</h2>
        <p class="text-sm text-cream/70 mt-1">Dine-in ✓ · Takeaway ✓ · No delivery · Till 12 midnight · Prices updated September 2026</p>
      </div>
      <Button href="tel:09274073791" variant="cream">Call 092740 73791</Button>
    </div>
  </main>

  <button
    id="cartFab"
    class="fixed bottom-5 right-5 z-40 bg-ink text-cream rounded-full pl-4 pr-2 py-2 flex items-center gap-3 shadow-[0_24px_50px_-20px_rgba(28,26,22,0.6)] hover:bg-pine active:scale-[0.98] transition-all"
    aria-label="Open your tray"
  >
    <span class="text-sm font-semibold"><span id="fabCount">0</span> items · <span id="fabTotal">₹0</span></span>
    <span class="w-10 h-10 rounded-full bg-cream/15 grid place-items-center" aria-hidden="true"
      ><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 7h16l-1.5 9h-13L4 7z" /><path d="M4 7l-1-3H1" /><circle cx="9" cy="20" r="1.4" /><circle cx="17" cy="20" r="1.4" /></svg></span
    >
  </button>

  <div id="toast" role="status" aria-live="polite" class="fixed bottom-6 left-1/2 -translate-x-1/2 translate-y-4 opacity-0 pointer-events-none transition-all duration-300 z-50 bg-ink text-cream text-sm font-semibold px-5 py-3 rounded-full shadow-[0_16px_40px_-16px_rgba(28,26,22,0.6)]"></div>

  <div id="cartBackdrop" class="hidden fixed inset-0 z-40 bg-ink/50 opacity-0" aria-hidden="true"></div>
  <aside
    id="cartPanel"
    role="dialog"
    aria-modal="true"
    aria-label="Your tray and checkout"
    class="fixed top-0 right-0 z-50 h-full w-full sm:w-[26rem] bg-cream shadow-2xl translate-x-full flex flex-col"
    style="transition:transform .6s cubic-bezier(0.16,1,0.3,1)"
  >
    <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-black/10">
      <div><h2 class="font-serif font-medium text-2xl">Your tray</h2><p class="text-xs text-neutral-500">Review, then check out.</p></div>
      <button id="cartClose" class="w-10 h-10 rounded-full border border-black/15 hover:bg-black/5" aria-label="Close tray">✕</button>
    </div>
    <div class="px-6 pt-4 grid grid-cols-2 gap-2 text-xs font-bold">
      <button class="mode px-3 py-2.5 rounded-full bg-ink text-cream" data-m="Dine-in">Dine-in</button>
      <button class="mode px-3 py-2.5 rounded-full border border-black/20" data-m="Takeaway">Takeaway</button>
    </div>
    <div id="cart" class="flex-1 overflow-y-auto px-6 py-4 space-y-3 text-sm"></div>
    <div class="px-6 pb-6 pt-4 border-t border-black/10 text-sm space-y-1.5 bg-creamcard rounded-t-[1.5rem]">
      <div class="flex justify-between text-neutral-500"><span>Total</span><b id="tItems">₹0</b></div>
      <div class="flex justify-between text-neutral-500"><span>GST (5%)</span><b id="tGst">₹0</b></div>
      <div class="flex justify-between font-bold text-lg"><span>Grand total</span><span id="tTotal">₹0</span></div>
      <button id="place" class="btn-fill btn-fill-dark mt-2 w-full bg-ink text-cream font-semibold py-3.5 rounded-full min-h-[48px] active:scale-[0.98]">Checkout →</button>
      <p id="msg" class="text-xs text-green-800 font-medium mt-2 hidden">Order noted! Pay at the counter.</p>
    </div>
  </aside>

  <script id="menu-data" type="application/json" set:html={JSON.stringify({ menu: MENU, cats: BASECATS })} />

  <script>
    type MenuItem = { name: string; cat: string; price: number; rating: string; img: string; desc: string; live?: number };
    type Category = { key: string; title: string; blurb: string; img: string; alt: string };

    const seed = JSON.parse((document.getElementById('menu-data') as HTMLElement).textContent || '{"menu":[],"cats":[]}') as {
      menu: MenuItem[];
      cats: Category[];
    };
    const MENU: MenuItem[] = seed.menu.map((m) => ({ ...m }));
    const CATIMG: Record<string, string> = { brew: '/assets/drink-2.avif', mocktail: '/assets/drink-3.avif', food: '/assets/food-2.avif' };

    try {
      const saved = JSON.parse(localStorage.getItem('belluno_menu_v1') || 'null');
      if (Array.isArray(saved) && saved.length) {
        MENU.length = 0;
        saved
          .filter((s) => s)
          .forEach((s) =>
            MENU.push({
              name: String(s.n || 'Untitled'),
              cat: s.c || 'food',
              price: Math.max(1, +s.p || 99),
              rating: s.r || '4.5',
              img: s.img || CATIMG[s.c] || CATIMG.food,
              desc: s.d || '',
              live: s.live ? 1 : 0,
            }),
          );
      }
    } catch (e) {}

    let CATS: Category[] = seed.cats.map((c) => ({ ...c }));
    try {
      const extra = JSON.parse(localStorage.getItem('belluno_cats_v1') || '[]');
      if (Array.isArray(extra))
        extra
          .filter((c) => c && c.key && c.title && !CATS.some((b) => b.key === c.key))
          .forEach((c) => CATS.push({ key: c.key, title: c.title, blurb: 'Fresh on the board.', img: c.img || '/assets/food-2.avif', alt: c.title }));
    } catch (e) {}

    (document.getElementById('jumpPills') as HTMLElement).innerHTML = CATS.map(
      (c) =>
        `<button data-t="cat-${c.key}" class="px-4 py-3 rounded-full border border-black/15 hover:bg-black/5 min-h-[44px]">${c.title
          .replace('Hot ', '')
          .replace('From the ', '')}</button>`,
    ).join('');

    let cart: Record<number, number> = {};
    const board = document.getElementById('board') as HTMLElement;
    const q = document.getElementById('q') as HTMLInputElement;
    const params = new URLSearchParams(location.search);
    if (params.get('q')) q.value = params.get('q') || '';

    function row(m: MenuItem) {
      const k = MENU.indexOf(m);
      const n = cart[k] || 0;
      if (m.live === 0)
        return `<div class="bg-white/60 border border-black/5 rounded-2xl px-4 sm:px-5 py-3.5 opacity-70">
        <div class="flex items-center gap-2">
          <p class="font-semibold text-[0.95rem] leading-tight">${m.name}</p>
          <span class="leader" aria-hidden="true"></span>
          <b class="text-[0.95rem] shrink-0 text-neutral-400">₹${m.price}</b>
          <span class="ml-1 shrink-0 text-[11px] font-bold uppercase tracking-wide text-neutral-500 bg-black/5 px-3 py-2 rounded-full">Unavailable</span>
        </div>
        <p class="text-xs text-neutral-400 mt-1">${m.desc} Back soon.</p>
      </div>`;
      return `<div class="bg-white border border-black/5 rounded-2xl px-4 sm:px-5 py-3.5 shadow-[0_18px_40px_-32px_rgba(28,26,22,0.5)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:shadow-[0_26px_50px_-30px_rgba(28,26,22,0.55)] hover:border-black/10">
        <div class="flex items-center gap-2">
          <p class="font-semibold text-[0.95rem] leading-tight">${m.name} <span class="text-[11px] font-medium text-neutral-400">★ ${m.rating}</span></p>
          <span class="leader" aria-hidden="true"></span>
          <b class="text-[0.95rem] shrink-0">₹${m.price}</b>
          <span class="flex items-center gap-1.5 ml-1 shrink-0">
            <button onclick="ch(${k},-1)" aria-label="Remove one ${m.name}" class="w-8 h-8 rounded-full border border-black/20 text-base leading-none hover:bg-ink hover:text-cream transition-colors">−</button>
            <b class="text-sm w-4 text-center" aria-live="polite">${n}</b>
            <button onclick="ch(${k},1)" aria-label="Add one ${m.name}" class="h-8 px-3.5 rounded-full bg-ink text-cream text-xs font-bold hover:bg-pine transition-colors">+ Add</button>
          </span>
        </div>
        <p class="text-xs text-neutral-500 mt-1">${m.desc}</p>
      </div>`;
    }

    function render() {
      const term = q.value.trim().toLowerCase();
      let total = 0;
      board.innerHTML =
        CATS.map((c) => {
          const items = MENU.filter((m) => m.cat === c.key && (m.name + ' ' + m.desc).toLowerCase().includes(term));
          if (!items.length) return '';
          total += items.length;
          return `<section id="cat-${c.key}" class="scroll-mt-28">
          <div class="relative overflow-hidden rounded-[1.75rem] h-40 sm:h-52">
            <img src="${c.img}" alt="${c.alt}" loading="lazy" class="absolute inset-0 w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/15 to-transparent" aria-hidden="true"></div>
            <div class="absolute bottom-4 left-5 right-5 flex items-end justify-between gap-3">
              <h2 class="font-serif italic font-medium text-cream text-3xl sm:text-4xl">${c.title}</h2>
              <p class="text-xs text-cream/75 hidden sm:block">${c.blurb}</p>
            </div>
          </div>
          <div class="mt-4 grid md:grid-cols-2 gap-3">${items.map(row).join('')}</div>
        </section>`;
        }).join('') || '<p class="text-sm text-neutral-500 py-8 text-center">Nothing matches that. Try “latte” or “spaghetti”.</p>';
      (document.getElementById('count') as HTMLElement).textContent = total + (total === 1 ? ' item' : ' items') + ' on the menu';
      renderCart();
    }

    function sums() {
      let t = 0;
      let n = 0;
      Object.entries(cart).forEach(([k, qty]) => {
        if (qty > 0) {
          t += MENU[+k].price * qty;
          n += qty;
        }
      });
      const gst = Math.round(t * 0.05);
      return { t, n, gst, grand: t + gst };
    }

    function renderCart() {
      const box = document.getElementById('cart') as HTMLElement;
      const rows = Object.entries(cart).filter(([, n]) => n > 0);
      box.innerHTML =
        rows
          .map(([k, n]) => {
            const m = MENU[+k];
            return `<div class="flex items-center gap-2 bg-white border border-black/5 rounded-2xl p-2.5">
          <img src="${m.img}" alt="${m.name}" loading="lazy" class="w-11 h-12 rounded-xl object-cover">
          <div class="flex-1 min-w-0"><b class="text-xs block truncate">${m.name}</b><p class="text-xs text-neutral-500">₹${m.price * n}</p></div>
          <div class="flex items-center gap-1.5">
            <button onclick="ch(${k},-1)" aria-label="Decrease quantity" class="w-7 h-7 rounded-full border border-black/20">−</button>
            <b class="text-xs">${n}</b>
            <button onclick="ch(${k},1)" aria-label="Increase quantity" class="w-7 h-7 rounded-full border border-black/20">+</button>
          </div></div>`;
          })
          .join('') || '<p class="text-xs text-neutral-400 py-6 text-center">Tray is empty.<br>Tap + Add beside anything that tempts you.</p>';
      const s = sums();
      (document.getElementById('tItems') as HTMLElement).textContent = '₹' + s.t;
      (document.getElementById('tGst') as HTMLElement).textContent = '₹' + s.gst;
      (document.getElementById('tTotal') as HTMLElement).textContent = '₹' + s.grand;
      (document.getElementById('fabCount') as HTMLElement).textContent = String(s.n);
      (document.getElementById('fabTotal') as HTMLElement).textContent = '₹' + s.grand;
    }

    let toastT: ReturnType<typeof setTimeout> | null = null;
    function toast(msg: string) {
      const t = document.getElementById('toast') as HTMLElement;
      t.textContent = msg + ' ✓';
      t.classList.remove('opacity-0', 'translate-y-4');
      if (toastT) clearTimeout(toastT);
      toastT = setTimeout(() => t.classList.add('opacity-0', 'translate-y-4'), 1600);
    }
    (window as unknown as { ch: (k: number, d: number) => void }).ch = (k, d) => {
      cart[k] = Math.max(0, (cart[k] || 0) + d);
      if (d > 0) toast(MENU[k].name + ' added');
      render();
    };
    q.addEventListener('input', render);
    (document.getElementById('jumpPills') as HTMLElement).addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      document.getElementById((b as HTMLElement).dataset.t || '')?.scrollIntoView({ behavior: 'smooth' });
    });
    document.querySelectorAll('.mode').forEach((b) =>
      b.addEventListener('click', () => {
        document.querySelectorAll('.mode').forEach((x) => (x.className = 'mode px-3 py-2.5 rounded-full border border-black/20'));
        b.className = 'mode px-3 py-2.5 rounded-full bg-ink text-cream';
      }),
    );

    const panel = document.getElementById('cartPanel') as HTMLElement;
    const backdrop = document.getElementById('cartBackdrop') as HTMLElement;
    function setCart(open: boolean) {
      panel.classList.toggle('translate-x-full', !open);
      backdrop.classList.toggle('hidden', !open);
      requestAnimationFrame(() => backdrop.classList.toggle('opacity-0', !open));
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) (document.getElementById('cartClose') as HTMLElement).focus();
    }
    (document.getElementById('cartFab') as HTMLElement).addEventListener('click', () => setCart(true));
    (document.getElementById('cartClose') as HTMLElement).addEventListener('click', () => setCart(false));
    backdrop.addEventListener('click', () => setCart(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setCart(false);
    });
    (document.getElementById('place') as HTMLElement).addEventListener('click', () =>
      (document.getElementById('msg') as HTMLElement).classList.remove('hidden'),
    );
    render();
  </script>
</SiteLayout>
