---
/** Menu Control — staff-only board editor. Bare layout (no global nav/footer). */
import BareLayout from '../layouts/BareLayout.astro';
import { ArrowRight, Plus } from '@keyline-icons/react/duotone';
---

<BareLayout title="Menu Control — Belluno" bar>
  <div id="adminGate" class="max-w-4xl mx-auto px-4 pt-16 pb-20">
    <div class="max-w-sm mx-auto bg-ink text-cream rounded-[1.75rem] p-7 sm:p-8 text-center">
      <img src="/assets/logo.avif" alt="Belluno logo" class="w-14 h-14 rounded-full object-cover mx-auto" />
      <p class="font-serif font-medium text-3xl mt-4">Staff only.</p>
      <p class="text-sm text-cream/60 mt-1">Enter the board password to continue.</p>
      <form id="gateForm" class="mt-5 space-y-2">
        <input
          id="gatePass"
          type="password"
          autocomplete="current-password"
          placeholder="Password"
          aria-label="Admin password"
          class="w-full bg-cream/10 border border-cream/20 rounded-xl px-3.5 py-3 text-cream placeholder:text-cream/40 min-h-[48px] text-center"
        />
        <button class="w-full bg-cream text-ink font-semibold py-3 rounded-xl min-h-[48px] hover:bg-white active:scale-[0.98] transition">Unlock</button>
      </form>
      <p id="gateErr" class="hidden text-xs text-amber-300 font-medium mt-2">Wrong password. Try again.</p>
    </div>
  </div>
  <main id="adminMain" class="max-w-4xl mx-auto px-4 pt-8 pb-20 hidden">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <span class="inline-block rounded-full px-3 py-1 text-[10px] uppercase tracking-[0.2em] font-medium bg-ink/5">Staff only · changes go live on the menu instantly</span>
        <h1 class="font-serif font-medium tracking-[-0.02em] text-4xl sm:text-5xl mt-3">Menu control.</h1>
      </div>
      <div class="flex items-center gap-2">
        <span id="saveState" class="text-xs font-semibold text-pine bg-pine/10 px-3.5 py-2 rounded-full inline-flex items-center gap-1.5"><span id="saveDot" class="w-1.5 h-1.5 rounded-full bg-current"></span><span id="saveLabel">Saved</span></span>
        <button id="resetBtn" class="text-xs font-semibold px-4 py-2.5 rounded-full border border-black/15 hover:bg-black/5 min-h-[44px]">Reset board</button>
        <a href="/menu" class="text-xs font-semibold px-4 py-2.5 rounded-full bg-ink text-cream hover:bg-pine min-h-[44px] inline-flex items-center gap-1.5">View menu <ArrowRight className="size-3.5" /></a>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-3 gap-3" id="stats"></div>

    <div class="mt-4 bg-ink text-cream rounded-[1.5rem] p-5">
      <div class="flex gap-2 text-xs font-semibold" role="tablist" aria-label="Add item or category">
        <button id="tabItem" role="tab" aria-selected="true" class="px-5 py-2.5 rounded-full bg-cream text-ink min-h-[44px] inline-flex items-center gap-1.5"><Plus className="size-4" /> Item</button>
        <button id="tabCat" role="tab" aria-selected="false" class="px-5 py-2.5 rounded-full border border-cream/30 text-cream min-h-[44px] inline-flex items-center gap-1.5"><Plus className="size-4" /> Category</button>
      </div>
      <div id="paneItem" role="tabpanel" class="mt-3 space-y-2">
        <input id="nName" class="w-full bg-cream/10 border border-cream/20 rounded-xl px-3.5 py-3 text-cream placeholder:text-cream/40 min-h-[48px]" placeholder="Item name — e.g. Hazelnut Frappe" aria-label="New item name" />
        <div class="grid grid-cols-2 gap-2">
          <select id="nCat" class="bg-cream/10 border border-cream/20 rounded-xl px-3 py-3 text-cream min-h-[48px]" aria-label="New item category"></select>
          <input id="nPrice" type="number" min="1" step="1" inputmode="numeric" class="bg-cream/10 border border-cream/20 rounded-xl px-3.5 py-3 text-cream placeholder:text-cream/40 min-h-[48px]" placeholder="₹ price (min 1)" aria-label="New item price, minimum 1" />
        </div>
        <button id="nAdd" class="w-full bg-cream text-ink font-semibold py-3 rounded-xl min-h-[48px] hover:bg-white active:scale-[0.98] transition inline-flex items-center justify-center gap-1.5"><Plus className="size-4" /> Add to menu</button>
        <p id="nErr" class="hidden text-xs text-amber-300 font-medium">Give it a name and a price of at least ₹1.</p>
      </div>
      <div id="paneCat" role="tabpanel" class="mt-3 space-y-2 hidden">
        <input id="cName" class="w-full bg-cream/10 border border-cream/20 rounded-xl px-3.5 py-3 text-cream placeholder:text-cream/40 min-h-[48px]" placeholder="Category name — e.g. Combos" aria-label="New category name" />
        <select id="cImg" class="w-full bg-cream/10 border border-cream/20 rounded-xl px-3 py-3 text-cream min-h-[48px]" aria-label="Category banner photo"></select>
        <button id="cAdd" class="w-full bg-cream text-ink font-semibold py-3 rounded-xl min-h-[48px] hover:bg-white active:scale-[0.98] transition inline-flex items-center justify-center gap-1.5"><Plus className="size-4" /> Add category</button>
        <p id="cErr" class="hidden text-xs text-amber-300 font-medium">Name it first — and check it does not exist yet.</p>
        <div id="catChips" class="flex flex-wrap gap-1.5"></div>
      </div>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row gap-2 sm:items-center">
      <div class="flex-1 flex items-center bg-white border border-black/10 rounded-full px-4 py-2.5">
        <input id="q" class="w-full bg-transparent outline-none text-sm" placeholder="Search items…" aria-label="Search items" />
      </div>
      <div class="flex flex-wrap gap-2 text-xs font-semibold" id="filterPills"></div>
    </div>

    <div id="rows" class="mt-4 space-y-2.5"></div>
  </main>

  <script>
    type Item = { n: string; c: string; p: number; r: string; live: number; img: string; d: string };
    type Cat = { key: string; title: string; img: string };
    const KEY = 'belluno_menu_v1';
    const CKEY = 'belluno_cats_v1';
    const IMG: Record<string, string> = { brew: '/assets/drink-2.avif', mocktail: '/assets/drink-3.avif', food: '/assets/food-2.avif' };
    const PHOTOS: [string, string][] = [
      ['/assets/drink-1.avif', 'Latte pour'], ['/assets/drink-2.avif', 'Cold brew'], ['/assets/drink-3.avif', 'Mocktail'],
      ['/assets/food-1.avif', 'Pink spaghetti'], ['/assets/food-2.avif', 'Sharing platter'], ['/assets/food-3.avif', 'Fries'],
      ['/assets/food-4.avif', 'Tiramisu'], ['/assets/food-5.avif', 'Chocolate torte'], ['/assets/kitchen.avif', 'Kitchen'],
      ['/assets/rooftop-1.avif', 'Rooftop day'], ['/assets/rooftop-2.avif', 'Rooftop dusk'], ['/assets/stairs.avif', 'Stairs'],
    ];
    const SEEDCATS: Cat[] = [
      { key: 'brew', title: 'Hot Brews', img: '/assets/drink-2.avif' },
      { key: 'mocktail', title: 'Mocktails', img: '/assets/drink-3.avif' },
      { key: 'food', title: 'From the Kitchen', img: '/assets/food-1.avif' },
    ];
    const SEED: Item[] = [
      { n: 'Espresso', c: 'brew', p: 149, r: '4.5', live: 1, img: '/assets/drink-1.avif', d: 'Short, bold, honest.' },
      { n: 'Pistachio Latte', c: 'brew', p: 249, r: '4.8', live: 1, img: '/assets/drink-1.avif', d: 'Nutty espresso, slow-steamed milk.' },
      { n: 'Cold Brew Tonic', c: 'brew', p: 229, r: '4.7', live: 1, img: '/assets/drink-2.avif', d: '18-hour brew, tonic, citrus peel.' },
      { n: 'Classic Cappuccino', c: 'brew', p: 199, r: '4.6', live: 1, img: '/assets/drink-2.avif', d: 'Double shot, velvet foam.' },
      { n: 'Filter Coffee', c: 'brew', p: 169, r: '4.6', live: 1, img: '/assets/drink-2.avif', d: 'Slow-dripped, jaggery option.' },
      { n: 'Berry Mocktail', c: 'mocktail', p: 199, r: '4.6', live: 1, img: '/assets/drink-3.avif', d: 'Fresh berries, mint, soda.' },
      { n: 'Virgin Mint Cooler', c: 'mocktail', p: 179, r: '4.5', live: 1, img: '/assets/drink-3.avif', d: 'Mint, lime, crushed ice.' },
      { n: 'Pink Spaghetti', c: 'food', p: 279, r: '4.9', live: 1, img: '/assets/food-1.avif', d: 'Rose sauce, basil, parmesan.' },
      { n: 'Villa Platter', c: 'food', p: 329, r: '4.7', live: 1, img: '/assets/food-2.avif', d: 'Sharing board, wood-fired bread.' },
      { n: 'Truffle Fries', c: 'food', p: 189, r: '4.5', live: 1, img: '/assets/food-3.avif', d: 'Parmesan snow, truffle oil.' },
      { n: 'Tiramisu Cup', c: 'food', p: 169, r: '4.8', live: 1, img: '/assets/food-4.avif', d: 'Espresso-soaked, mascarpone.' },
      { n: 'Choco Torte', c: 'food', p: 179, r: '4.6', live: 1, img: '/assets/food-5.avif', d: 'Dark chocolate, sea salt.' },
    ];
    function load<T>(k: string, fb: T): T {
      try {
        const v = JSON.parse(localStorage.getItem(k) as string);
        return v == null ? fb : (v as T);
      } catch (e) {
        return fb;
      }
    }
    function saveLS(k: string, v: unknown) {
      try {
        localStorage.setItem(k, JSON.stringify(v));
      } catch (e) {}
    }
    let items: Item[] = load<Item[] | null>(KEY, null) as Item[] | null as unknown as Item[];
    if (!Array.isArray(items) || !items.length) items = JSON.parse(JSON.stringify(SEED));
    let cats: Cat[] = load<Cat[] | null>(CKEY, null) as Cat[] | null as unknown as Cat[];
    if (!Array.isArray(cats) || !cats.length) cats = JSON.parse(JSON.stringify(SEEDCATS));
    let filter = 'all';
    const rows = document.getElementById('rows') as HTMLElement;
    const q = document.getElementById('q') as HTMLInputElement;
    const saveState = document.getElementById('saveState') as HTMLElement;
    const nCat = document.getElementById('nCat') as HTMLSelectElement;
    /* Keyline duotone artwork (same paths as @keyline-icons/react/duotone) for JS-rendered rows. */
    const svgOpen = (s: number) =>
      `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">`;
    const X_SVG = svgOpen(14) + '<path d="M7 7L17 17M17 7L7 17"/></svg>';
    const CHEV_L_SVG = svgOpen(14) + '<path d="M15 6L9 12L15 18"/></svg>';
    const CHEV_R_SVG = svgOpen(14) + '<path d="M9 6L15 12L9 18"/></svg>';
    const GRIP_SVG =
      svgOpen(16) +
      '<path d="M10 5C10 5.5523 9.5523 6 9 6C8.4477 6 8 5.5523 8 5C8 4.4477 8.4477 4 9 4C9.5523 4 10 4.4477 10 5ZM10 12C10 12.5523 9.5523 13 9 13C8.4477 13 8 12.5523 8 12C8 11.4477 8.4477 11 9 11C9.5523 11 10 11.4477 10 12ZM10 19C10 19.5523 9.5523 20 9 20C8.4477 20 8 19.5523 8 19C8 18.4477 8.4477 18 9 18C9.5523 18 10 18.4477 10 19ZM16 5C16 5.5523 15.5523 6 15 6C14.4477 6 14 5.5523 14 5C14 4.4477 14.4477 4 15 4C15.5523 4 16 4.4477 16 5ZM16 12C16 12.5523 15.5523 13 15 13C14.4477 13 14 12.5523 14 12C14 11.4477 14.4477 11 15 11C15.5523 11 16 11.4477 16 12ZM16 19C16 19.5523 15.5523 20 15 20C14.4477 20 14 19.5523 14 19C14 18.4477 14.4477 18 15 18C15.5523 18 16 18.4477 16 19Z"/></svg>';

    let flashT: ReturnType<typeof setTimeout> | null = null;
    function flash() {
      (document.getElementById('saveLabel') as HTMLElement).textContent = 'Saving…';
      saveState.className = 'text-xs font-semibold text-amber-700 bg-amber-100 px-3.5 py-2 rounded-full inline-flex items-center gap-1.5';
      if (flashT) clearTimeout(flashT);
      flashT = setTimeout(() => {
        (document.getElementById('saveLabel') as HTMLElement).textContent = 'Saved';
        saveState.className = 'text-xs font-semibold text-pine bg-pine/10 px-3.5 py-2 rounded-full inline-flex items-center gap-1.5';
      }, 600);
    }
    function persist() {
      saveLS(KEY, items);
      saveLS(CKEY, cats);
      flash();
    }
    function slug(s: string) {
      return s.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 24) || 'cat';
    }
    function syncCatUI() {
      nCat.innerHTML = cats.map((c) => `<option value="${c.key}">${c.title}</option>`).join('');
      (document.getElementById('cImg') as HTMLElement).innerHTML = PHOTOS.map((p) => `<option value="${p[0]}">${p[1]}</option>`).join('');
      (document.getElementById('filterPills') as HTMLElement).innerHTML =
        `<button data-f="all" class="${filter === 'all' ? 'bg-ink text-cream' : 'border border-black/15'} px-4 py-2.5 rounded-full min-h-[44px]">All</button>` +
        cats.map((c) => `<button data-f="${c.key}" class="${filter === c.key ? 'bg-ink text-cream' : 'border border-black/15'} px-4 py-2.5 rounded-full min-h-[44px]">${c.title}</button>`).join('');
      (document.getElementById('catChips') as HTMLElement).innerHTML = cats
        .map((c) => {
          const used = items.filter((i) => i.c === c.key).length;
          const seeded = SEEDCATS.some((s) => s.key === c.key);
          const canDel = !seeded && used === 0;
          return `<span draggable="true" data-cdrag="${c.key}" class="inline-flex items-center gap-1 text-xs font-medium bg-cream/10 text-cream rounded-full pl-1 pr-1.5 py-1.5 cursor-grab" title="Drag to reorder">
          <button data-cmove="${c.key}|-1" aria-label="Move ${c.title} earlier" class="w-6 h-6 rounded-full hover:bg-cream/20 grid place-items-center">${CHEV_L_SVG}</button>
          <span class="px-1">${c.title} · ${used}</span>
          <button data-cmove="${c.key}|1" aria-label="Move ${c.title} later" class="w-6 h-6 rounded-full hover:bg-cream/20 grid place-items-center">${CHEV_R_SVG}</button>` +
            (canDel
              ? `<button data-delcat="${c.key}" aria-label="Delete category ${c.title}" class="w-6 h-6 rounded-full hover:bg-cream/20 text-cream/60 grid place-items-center">${X_SVG}</button>`
              : `<span class="w-1.5"></span>`) + `</span>`;
        })
        .join('');
    }
    function stats() {
      const live = items.filter((i) => i.live).length;
      (document.getElementById('stats') as HTMLElement).innerHTML = [
        [items.length, 'items total'],
        [live, 'available now'],
        [cats.length, 'categories'],
      ]
        .map(
          (s) =>
            `<div class="bg-white border border-black/5 rounded-2xl p-4 text-center"><p class="font-serif text-3xl">${s[0]}</p><p class="text-xs text-neutral-400 mt-0.5">${s[1]}</p></div>`,
        )
        .join('');
    }
    function render() {
      const term = q.value.trim().toLowerCase();
      const list = items.map((m, i) => ({ m, i })).filter(({ m }) => (filter === 'all' || m.c === filter) && (m.n + ' ' + (m.d || '')).toLowerCase().includes(term));
      rows.innerHTML =
        list
          .map(
            ({ m, i }) => `
      <article draggable="true" data-drag="${i}" class="bg-white border border-black/5 rounded-2xl p-3 flex items-center gap-2 sm:gap-3 ${m.live ? '' : 'opacity-55'}">
        <span class="drag-handle shrink-0 cursor-grab select-none text-neutral-300 hover:text-ink px-1.5 py-2 inline-flex" title="Drag to reorder" aria-hidden="true">${GRIP_SVG}</span>
        <div class="flex-1 min-w-0 grid sm:grid-cols-[1fr_9rem_6rem] gap-2 items-center">
          <input value="${m.n.replace(/"/g, '&quot;')}" data-i="${i}" data-k="n" aria-label="Item name" class="font-semibold bg-transparent border border-transparent hover:border-black/15 focus:border-ink rounded-lg px-2 py-2 min-h-[44px] w-full">
          <select data-i="${i}" data-k="c" aria-label="Category" class="border border-black/15 rounded-lg px-2 py-2 bg-white text-xs font-medium min-h-[44px]">
            ${cats.map((c) => `<option value="${c.key}" ${c.key === m.c ? 'selected' : ''}>${c.title}</option>`).join('')}
          </select>
          <div class="flex items-center gap-1 text-sm"><span class="text-neutral-400">₹</span><input type="number" min="1" inputmode="numeric" value="${m.p}" data-i="${i}" data-k="p" aria-label="Price in rupees" class="border border-black/15 rounded-lg px-2 py-2 w-full font-semibold min-h-[44px]"></div>
        </div>
        <label class="flex flex-col items-center gap-1 shrink-0" title="Show on menu">
          <input type="checkbox" data-i="${i}" data-k="live" ${m.live ? 'checked' : ''} class="switch" aria-label="Show on menu">
          <span class="text-[10px] font-semibold ${m.live ? 'text-pine' : 'text-neutral-400'}">${m.live ? 'AVAILABLE' : 'UNAVAILABLE'}</span>
        </label>
        <button data-del="${i}" aria-label="Delete item" class="shrink-0 w-11 h-11 rounded-full text-neutral-300 hover:text-red-600 hover:bg-red-50 grid place-items-center transition-colors">${X_SVG}</button>
      </article>`,
          )
          .join('') || '<p class="text-sm text-neutral-400 text-center py-8">No items match. Clear the search or add a new one above.</p>';
      stats();
    }
    function renderAll() {
      syncCatUI();
      render();
    }
    rows.addEventListener('change', (e) => {
      const t = e.target as HTMLElement & { dataset: DOMStringMap; type: string; value: string; checked: boolean };
      if ((t as HTMLElement).closest('[data-del]')) return;
      const i = +(t.dataset.i || NaN);
      const k = t.dataset.k;
      if (isNaN(i) || !k) return;
      if (t.type === 'checkbox') items[i][k === 'live' ? 'live' : k] = (t.checked ? 1 : 0) as never;
      else if (k === 'p') items[i].p = Math.max(1, +t.value || 1);
      else if (k === 'c') items[i].c = t.value;
      else items[i].n = t.value;
      persist();
      render();
      syncCatUI();
    });
    rows.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('[data-del]');
      if (!b) return;
      if (!confirm('Remove “' + items[+(b as HTMLElement).dataset.del!].n + '” from the menu?')) return;
      items.splice(+(b as HTMLElement).dataset.del!, 1);
      persist();
      renderAll();
    });
    let dragI: number | null = null;
    rows.addEventListener('dragstart', (e) => {
      const a = (e.target as HTMLElement).closest('[data-drag]');
      if (!a) return;
      if ((e.target as HTMLElement).closest('input,select,button')) {
        e.preventDefault();
        return;
      }
      dragI = +((a as HTMLElement).dataset.drag || 0);
      e.dataTransfer!.effectAllowed = 'move';
    });
    rows.addEventListener('dragover', (e) => {
      const a = (e.target as HTMLElement).closest('[data-drag]');
      if (!a || dragI === null) return;
      e.preventDefault();
    });
    rows.addEventListener('drop', (e) => {
      const a = (e.target as HTMLElement).closest('[data-drag]');
      if (!a || dragI === null) return;
      e.preventDefault();
      const ti = +((a as HTMLElement).dataset.drag || 0);
      if (ti !== dragI) {
        const [mv] = items.splice(dragI, 1);
        items.splice(ti, 0, mv);
        persist();
        renderAll();
      }
      dragI = null;
    });
    rows.addEventListener('dragend', () => {
      dragI = null;
    });
    (document.getElementById('filterPills') as HTMLElement).addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      filter = (b as HTMLElement).dataset.f || 'all';
      syncCatUI();
      render();
    });
    const chipBox = document.getElementById('catChips') as HTMLElement;
    chipBox.addEventListener('click', (e) => {
      const mv = (e.target as HTMLElement).closest('[data-cmove]');
      if (mv) {
        const [key, dir] = ((mv as HTMLElement).dataset.cmove || '|').split('|');
        const i = cats.findIndex((c) => c.key === key);
        const j = i + +dir;
        if (i < 0 || j < 0 || j >= cats.length) return;
        const [c] = cats.splice(i, 1);
        cats.splice(j, 0, c);
        persist();
        renderAll();
        return;
      }
      const b = (e.target as HTMLElement).closest('[data-delcat]');
      if (!b) return;
      cats = cats.filter((c) => c.key !== (b as HTMLElement).dataset.delcat);
      persist();
      renderAll();
    });
    let cdrag: string | null = null;
    chipBox.addEventListener('dragstart', (e) => {
      const s = (e.target as HTMLElement).closest('[data-cdrag]');
      if (!s) return;
      if ((e.target as HTMLElement).closest('button')) {
        e.preventDefault();
        return;
      }
      cdrag = (s as HTMLElement).dataset.cdrag || null;
      e.dataTransfer!.effectAllowed = 'move';
    });
    chipBox.addEventListener('dragover', (e) => {
      if (!(e.target as HTMLElement).closest('[data-cdrag]') || !cdrag) return;
      e.preventDefault();
    });
    chipBox.addEventListener('drop', (e) => {
      const s = (e.target as HTMLElement).closest('[data-cdrag]');
      if (!s || !cdrag) return;
      e.preventDefault();
      const from = cats.findIndex((c) => c.key === cdrag);
      const to = cats.findIndex((c) => c.key === (s as HTMLElement).dataset.cdrag);
      if (from > -1 && to > -1 && from !== to) {
        const [c] = cats.splice(from, 1);
        cats.splice(to, 0, c);
        persist();
        renderAll();
      }
      cdrag = null;
    });
    chipBox.addEventListener('dragend', () => {
      cdrag = null;
    });
    q.addEventListener('input', render);
    const tabItem = document.getElementById('tabItem') as HTMLElement;
    const tabCat = document.getElementById('tabCat') as HTMLElement;
    const paneItem = document.getElementById('paneItem') as HTMLElement;
    const paneCat = document.getElementById('paneCat') as HTMLElement;
    function setTab(item: boolean) {
      paneItem.classList.toggle('hidden', !item);
      paneCat.classList.toggle('hidden', item);
      tabItem.setAttribute('aria-selected', String(item));
      tabCat.setAttribute('aria-selected', String(!item));
      tabItem.className = 'px-5 py-2.5 rounded-full min-h-[44px] ' + (item ? 'bg-cream text-ink' : 'border border-cream/30 text-cream');
      tabCat.className = 'px-5 py-2.5 rounded-full min-h-[44px] ' + (!item ? 'bg-cream text-ink' : 'border border-cream/30 text-cream');
    }
    tabItem.addEventListener('click', () => setTab(true));
    tabCat.addEventListener('click', () => setTab(false));
    const nPriceEl = document.getElementById('nPrice') as HTMLInputElement;
    nPriceEl.addEventListener('change', () => {
      if (nPriceEl.value !== '' && +nPriceEl.value < 1) nPriceEl.value = '1';
    });
    (document.getElementById('nAdd') as HTMLElement).addEventListener('click', () => {
      const n = (document.getElementById('nName') as HTMLInputElement).value.trim();
      const p = +(document.getElementById('nPrice') as HTMLInputElement).value;
      const err = document.getElementById('nErr') as HTMLElement;
      if (!n || !(p > 0)) {
        err.classList.remove('hidden');
        return;
      }
      err.classList.add('hidden');
      items.unshift({ n, c: nCat.value, p, r: '4.5', live: 1, img: IMG[nCat.value] || '/assets/food-2.avif', d: 'New on the board.' });
      (document.getElementById('nName') as HTMLInputElement).value = '';
      (document.getElementById('nPrice') as HTMLInputElement).value = '';
      persist();
      render();
      (document.getElementById('nName') as HTMLInputElement).focus();
    });
    (document.getElementById('cAdd') as HTMLElement).addEventListener('click', () => {
      const name = (document.getElementById('cName') as HTMLInputElement).value.trim();
      const err = document.getElementById('cErr') as HTMLElement;
      const key = slug(name);
      if (!name || cats.some((c) => c.key === key)) {
        err.classList.remove('hidden');
        return;
      }
      err.classList.add('hidden');
      cats.push({ key, title: name, img: (document.getElementById('cImg') as HTMLSelectElement).value });
      (document.getElementById('cName') as HTMLInputElement).value = '';
      persist();
      renderAll();
    });
    (document.getElementById('resetBtn') as HTMLElement).addEventListener('click', () => {
      if (!confirm('Reset the board to the original items and 3 categories?')) return;
      items = JSON.parse(JSON.stringify(SEED));
      cats = JSON.parse(JSON.stringify(SEEDCATS));
      filter = 'all';
      persist();
      renderAll();
    });
    /* soft password gate — keeps honest visitors out, not attackers.
       Real protection needs server-side auth, which a static build has not. */
    const gate = document.getElementById('adminGate') as HTMLElement;
    const adminMain = document.getElementById('adminMain') as HTMLElement;
    function unlock() {
      gate.classList.add('hidden');
      adminMain.classList.remove('hidden');
      renderAll();
    }
    try {
      if (sessionStorage.getItem('belluno_admin') === '1') {
        unlock();
      } else {
        (document.getElementById('gateForm') as HTMLElement).addEventListener('submit', (e) => {
          e.preventDefault();
          const pass = (document.getElementById('gatePass') as HTMLInputElement).value;
          if (pass === 'Belluno123') {
            try {
              sessionStorage.setItem('belluno_admin', '1');
            } catch (err) {}
            unlock();
          } else {
            (document.getElementById('gateErr') as HTMLElement).classList.remove('hidden');
          }
        });
      }
    } catch (e) {
      unlock();
    }
  </script>
</BareLayout>
