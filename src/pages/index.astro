---
/** Home — cinematic hero, signatures, mosaic gallery, review river, FAQ, visit. */
import SiteLayout from '../layouts/SiteLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Schema from '../components/Schema.astro';
import { Star, ArrowRight, Plus, Quote } from '@keyline-icons/react/duotone';
import { SIGNATURES, TESTIMONIALS, GALLERY } from '../data/site';
import { SITE, BUSINESS } from '../lib/site';

const stars = [0, 1, 2, 3, 4];

const catLabel: Record<string, string> = { brew: 'Hot Brew', mocktail: 'Mocktail', food: 'From Kitchen' };
const river = [...TESTIMONIALS, ...TESTIMONIALS];
const cafeSchema = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  '@id': SITE + '/#cafe',
  name: 'Belluno',
  image: SITE + '/assets/hero-desktop.avif',
  url: SITE,
  telephone: BUSINESS.phone,
  priceRange: '₹₹',
  servesCuisine: ['Coffee', 'Cafe Food', 'Italian'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.street,
    addressLocality: BUSINESS.city,
    addressRegion: BUSINESS.region,
    postalCode: BUSINESS.postal,
    addressCountry: BUSINESS.country,
  },
  openingHours: BUSINESS.hours,
  hasMap: BUSINESS.maps,
  aggregateRating: { '@type': 'AggregateRating', ratingValue: BUSINESS.rating, reviewCount: BUSINESS.reviews },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { q: 'What are your hours?', a: 'Open every day, till 12 midnight. Rooftop seats fill fast after sunset, so come early for golden hour.' },
    { q: 'Do you deliver?', a: 'No delivery. Everything is dine-in or takeaway, so it reaches you exactly as the kitchen intended.' },
    { q: 'Can I reserve a rooftop table?', a: 'Yes. Call 092740 73791 and tell us the evening and headcount. Groups above six should book a day ahead.' },
    { q: 'What should I order first?', a: 'Pistachio Latte, Cold Brew Tonic, Pink Spaghetti, and a house mocktail. Those four built our 4.6 rating.' },
    { q: 'Where exactly are you?', a: 'VIP Road, opposite Marina Grand Hospital, Vesu, Surat 395007. Plus code 4QP6+66. Street parking outside.' },
  ].map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<SiteLayout
  title="Belluno Rooftop Cafe — Vesu, Surat | Coffee & Kitchen"
  description="Belluno is a rooftop villa cafe in Vesu, Surat — Pistachio Latte, Cold Brew Tonic, Pink Spaghetti. Rated 4.6 by 891 patrons. Open daily till midnight."
  active="home"
>
  <Schema data={cafeSchema} />
  <Schema data={faqSchema} />
  <!-- HERO · Architecture A, Cinematic Center -->
  <section class="relative min-h-[100dvh] overflow-hidden flex items-center justify-center overflow-x-hidden">
    <div class="absolute inset-0">
      <img
        id="heroBg"
        src="/assets/hero-desktop.avif"
        alt="Belluno villa facade glowing at dusk"
        class="w-full h-full object-cover scale-[1.12] will-change-transform"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/25 to-ink/10" aria-hidden="true"></div>
    <div
      class="relative z-10 flex flex-col items-center justify-center text-center text-cream px-4 pt-32 pb-24 w-full max-w-5xl mx-auto"
      data-hero-stagger
    >
      <p class="text-xs tracking-[0.25em] uppercase text-cream/70" style="--i:0">Vesu Surat · Open till midnight</p>
      <h1 id="heroTitle" class="hero-h font-serif mt-4" style="--i:1">Good food,<br /><em class="font-light">great coffee.</em></h1>
      <p class="mt-5 text-cream/80 max-w-[45ch] leading-relaxed" style="--i:2">
        Boutique villa calm with Bali greens. Slow coffee and late evenings on VIP Road.
      </p>
      <div class="mt-7 flex items-center justify-center gap-4" style="--i:3">
        <div class="flex -space-x-3">
          <img src="/assets/drink-1.avif" class="w-11 h-11 rounded-full border-2 border-cream/80 object-cover relative transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-125 hover:-translate-y-1 hover:z-10" alt="Patron enjoying a Pistachio Latte" loading="lazy" />
          <img src="/assets/food-1.avif" class="w-11 h-11 rounded-full border-2 border-cream/80 object-cover relative transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-125 hover:-translate-y-1 hover:z-10" alt="Signature Pink Spaghetti" loading="lazy" />
          <img src="/assets/rooftop-1.avif" class="w-11 h-11 rounded-full border-2 border-cream/80 object-cover relative transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-125 hover:-translate-y-1 hover:z-10" alt="Rooftop evening at Belluno" loading="lazy" />
          <span class="w-11 h-11 rounded-full border-2 border-cream/80 bg-cream text-ink text-[10px] font-bold grid place-items-center">891+</span>
        </div>
        <div class="text-left">
          <div class="tracking-widest text-sm text-amber-300 flex items-center gap-0.5">{stars.map(() => <Star className="size-4" />)} <span class="text-cream font-bold ml-1">4.6</span></div>
          <p class="text-xs text-cream/75">891 verified patron reviews</p>
        </div>
      </div>
      <div class="mt-6 flex flex-wrap justify-center gap-3" style="--i:4">
        <Button href="/menu" variant="cream">Explore Menu <ArrowRight className="size-4" /></Button>
        <Button href="/contact" variant="creamOutline">Find Us</Button>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="bg-ink text-cream overflow-hidden py-3" aria-hidden="true">
    <div class="flex gap-8 whitespace-nowrap text-xs font-semibold tracking-[0.2em] uppercase animate-[marquee_28s_linear_infinite]" style="width:max-content">
      <span>Pistachio Latte</span><span>·</span><span>Cold Brew Tonic</span><span>·</span><span>Pink Spaghetti</span><span>·</span><span>Rooftop Evenings</span><span>·</span><span>Open Till Midnight</span><span>·</span><span>Pistachio Latte</span><span>·</span><span>Cold Brew Tonic</span><span>·</span><span>Pink Spaghetti</span><span>·</span><span>Rooftop Evenings</span><span>·</span><span>Open Till Midnight</span><span>·</span>
    </div>
  </div>

  <main id="main">
    <!-- SIGNATURES -->
    <section class="max-w-6xl mx-auto px-4 py-24 sm:py-32 reveal">
      <div class="flex items-end justify-between mb-8">
        <div>
          <Badge>Signatures</Badge>
          <h2 class="text-4xl sm:text-5xl font-serif font-medium tracking-[-0.02em] mt-3">Loved by Surat</h2>
        </div>
        <a href="/menu" class="group text-sm font-semibold inline-flex items-center gap-2"
          >Full menu <span class="w-8 h-8 rounded-full bg-black/5 grid place-items-center transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-1"><ArrowRight className="size-4" /></span></a
        >
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          SIGNATURES.map((m, i) => (
            <div class:list={['bezel bg-white', i === 1 && 'md:scale-[1.04] md:z-10', 'transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2']}>
              <article class="bezel-inner group relative overflow-hidden bg-ink transition-shadow duration-700 hover:shadow-[0_36px_70px_-28px_rgba(28,26,22,0.6)]">
                <img src={m.img} alt={m.name} loading="lazy" class="h-96 sm:h-[28rem] w-full object-cover transition-transform duration-[1.4s] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.06]" />
                <div class="absolute top-3 inset-x-3 flex items-start justify-between gap-2">
                  <div class="flex flex-wrap gap-1.5">
                    <span class="text-[11px] font-semibold text-white bg-white/20 backdrop-blur-md border border-white/30 px-3 py-1.5 rounded-full">{catLabel[m.cat] ?? m.cat}</span>
                    <span class="text-[11px] font-semibold text-white bg-white/20 backdrop-blur-md border border-white/30 px-3 py-1.5 rounded-full">Veg</span>
                  </div>
                  <span class="text-[11px] font-semibold text-white bg-white/20 backdrop-blur-md border border-white/30 px-3 py-1.5 rounded-full shrink-0 inline-flex items-center gap-1"><Star className="size-3" /> {m.rating}</span>
                </div>
                <div class="absolute bottom-3 inset-x-3 rounded-2xl bg-gradient-to-t from-black/50 to-white/10 backdrop-blur-xl border border-white/30 p-4 text-white">
                  <h3 class="font-semibold text-lg leading-tight">{m.name}</h3>
                  <p class="text-[13px] text-white/80 mt-0.5">{m.desc}</p>
                  <div class="mt-3 flex items-center justify-between gap-2">
                    <span class="text-sm font-bold text-ink bg-cream px-4 py-2 rounded-full">₹{m.price}</span>
                    <a href="/menu" class="group/btn text-sm font-semibold text-ink bg-cream pl-4 pr-1.5 py-1.5 rounded-full inline-flex items-center gap-2 hover:bg-white active:scale-[0.98] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
                      Add <span class="w-7 h-7 rounded-full bg-ink text-cream grid place-items-center transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/btn:translate-x-0.5"><Plus className="size-4" /></span>
                    </a>
                  </div>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </section>

    <!-- GALLERY · mosaic editorial -->
    <section class="py-24 sm:py-32 reveal">
      <div class="max-w-6xl mx-auto px-4">
        <Badge>Inside Belluno</Badge>
        <div class="mt-4 grid md:grid-cols-2 gap-4 items-end">
          <h2 class="font-serif font-medium tracking-[-0.02em] leading-[0.95] text-5xl sm:text-7xl">The villa<br />vibe.</h2>
          <p class="text-sm text-neutral-500 leading-relaxed md:text-right md:justify-self-end max-w-[32ch]">
            Curved walls, warm light, green air. Captured across our rooftop and kitchen.
          </p>
        </div>
        <div class="mt-10 grid grid-cols-3 gap-3 sm:gap-4">
          {
            GALLERY.map((g) => (
              <img
                src={g.img}
                alt={g.alt}
                loading="lazy"
                class:list={[g.span, 'w-full', g.h, 'object-cover rounded-[1.25rem] transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-[1.03] hover:-translate-y-1 hover:z-10 relative']}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS · centered heading, right-to-left river -->
    <section class="py-24 sm:py-32 reveal overflow-hidden">
      <div class="max-w-6xl mx-auto px-4 text-center">
        <Badge>Word on the street</Badge>
        <h2 class="font-serif font-medium tracking-[-0.02em] text-4xl sm:text-6xl mt-3">See what all<br />the talk is about</h2>
        <div class="mt-6 flex items-center justify-center gap-4">
          <div class="flex -space-x-3">
            <img src="/assets/drink-1.avif" class="w-10 h-10 rounded-full border-2 border-cream object-cover relative transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-125 hover:-translate-y-1 hover:z-10" alt="Patron" loading="lazy" />
            <img src="/assets/food-1.avif" class="w-10 h-10 rounded-full border-2 border-cream object-cover relative transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-125 hover:-translate-y-1 hover:z-10" alt="Signature dish" loading="lazy" />
            <img src="/assets/rooftop-1.avif" class="w-10 h-10 rounded-full border-2 border-cream object-cover relative transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-125 hover:-translate-y-1 hover:z-10" alt="Rooftop" loading="lazy" />
            <span class="w-10 h-10 rounded-full border-2 border-cream bg-ink text-cream text-[10px] font-bold grid place-items-center">891+</span>
          </div>
          <div class="text-left">
            <div class="tracking-widest text-sm text-amber-600 flex items-center gap-0.5">{stars.map(() => <Star className="size-4" />)} <span class="text-ink font-bold ml-1">4.6</span></div>
            <p class="text-xs text-neutral-500">4.6 stars from 891 verified patrons</p>
          </div>
        </div>
      </div>
      <div class="tmarquee-pause mt-12 overflow-hidden">
        <div class="flex gap-5 pr-5" id="testiTrack" style="width:max-content">
          {
            river.map((t) => (
              <article class="group w-72 sm:w-80 shrink-0 bg-white border border-black/5 rounded-[1.5rem] overflow-hidden text-left shadow-[0_18px_40px_-28px_rgba(28,26,22,0.4)] transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 hover:shadow-[0_32px_64px_-28px_rgba(28,26,22,0.55)]">
                <div class="overflow-hidden">
                  <img src={t.img} class="h-44 w-full object-cover fade-mask transition-transform duration-[1.2s] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105" alt={`Patron photo (stand-in) — ${t.n}`} loading="lazy" />
                </div>
                <div class="p-6 pt-2">
                  <div class="text-pine"><Quote className="size-7" /></div>
                  <p class="text-sm leading-relaxed mt-1">{t.q}</p>
                  <p class="mt-4 text-xs text-neutral-400 text-right">— {t.n} · verified patron</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
      <p class="text-center text-xs text-neutral-400 mt-8">Patron photos are illustrative stand-ins until real review avatars are supplied.</p>
    </section>

    <!-- FAQ -->
    <section class="max-w-6xl mx-auto px-4 py-24 sm:py-32 reveal">
      <div class="grid lg:grid-cols-[1fr_1.6fr] gap-10">
        <div class="lg:sticky lg:top-28 self-start">
          <Badge>Good to know</Badge>
          <h2 class="font-serif font-medium tracking-[-0.02em] text-4xl sm:text-5xl mt-3">Questions,<br />answered.</h2>
          <p class="text-sm text-neutral-500 mt-3 max-w-[38ch]">
            Anything else? Call <a class="underline underline-offset-4 font-semibold text-ink" href="tel:09274073791">092740 73791</a>, we reply fast.
          </p>
        </div>
        <div class="divide-y divide-black/10 border-y border-black/10">
          {
            [
              ['What are your hours?', 'Open every day, till 12 midnight. Rooftop seats fill fast after sunset, so come early for golden hour.', true],
              ['Do you deliver?', 'No delivery. Everything is dine-in or takeaway, so it reaches you exactly as the kitchen intended.', false],
              ['Can I reserve a rooftop table?', 'Yes. Call 092740 73791 and tell us the evening and headcount. Groups above six should book a day ahead.', false],
              ['What should I order first?', 'Pistachio Latte, Cold Brew Tonic, Pink Spaghetti, and a house mocktail. Those four built our 4.6 rating.', false],
              ['Where exactly are you?', 'VIP Road, opposite Marina Grand Hospital, Vesu, Surat 395007. Plus code 4QP6+66. Street parking outside.', false],
            ].map(([q, a, open]) => (
              <details class="group py-5" open={open ? true : undefined}>
                <summary class="flex items-center justify-between gap-4 cursor-pointer font-semibold list-none">
                  {q}
                  <span class="w-8 h-8 shrink-0 rounded-full bg-black/5 grid place-items-center transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-open:rotate-45"><Plus className="size-4" /></span>
                </summary>
                <p class="text-sm text-neutral-500 mt-2 max-w-[55ch] leading-relaxed">{a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- VISIT -->
    <section class="max-w-6xl mx-auto px-4 py-24 sm:py-32 reveal">
      <div class="bezel">
        <div class="bezel-inner relative overflow-hidden text-cream rounded-[calc(2rem-0.4rem)]">
          <img src="/assets/rooftop-2.avif" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#15291E] via-[#15291E]/80 to-[#15291E]/5" aria-hidden="true"></div>
          <div class="relative p-8 sm:p-12 lg:p-16 max-w-xl">
            <Badge dark>Visit</Badge>
            <h2 class="font-serif font-medium tracking-[-0.02em] leading-[1.0] text-4xl sm:text-6xl mt-4">Slow evenings<br />on the rooftop.</h2>
            <p class="mt-4 text-sm text-cream/75 leading-relaxed">
              Opp. Marina Grand Hospital, VIP Rd, Vesu, Surat 395007 · Open daily till 12:00 AM · Dine-in + Takeaway
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <Button href="tel:09274073791" variant="cream">Call 092740 73791</Button>
              <Button href="/contact" variant="creamOutline">Get directions</Button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const heroBg = document.getElementById('heroBg');
    if (heroBg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let pTick = false;
      window.addEventListener(
        'scroll',
        () => {
          if (pTick) return;
          pTick = true;
          requestAnimationFrame(() => {
            const y = window.scrollY;
            const vh = window.innerHeight;
            if (y < vh * 1.3) heroBg.style.transform = `translateY(${(y * 0.28).toFixed(1)}px) scale(1.12)`;
            pTick = false;
          });
        },
        { passive: true },
      );
    }
    try {
      const t = localStorage.getItem('belluno_hero');
      if (t) (document.getElementById('heroTitle') as HTMLElement).innerHTML = t;
    } catch (e) {}
  </script>
</SiteLayout>
